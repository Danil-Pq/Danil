    case "$1" in
    255 ) echo "Работа приложения завершена с ошибкой";;
    * ) echo "Неизвестная ошибка";;
    esac
}

function code_to_error_en() {
    case "$1" in
    255 ) echo "App was terminate with error";;
    * ) echo "Unknown error";;
    esac
}


